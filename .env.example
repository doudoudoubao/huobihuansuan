# ============ 必填 ============
# 从 @BotFather 申请，形如 123456:ABC-DEF...
BOT_TOKEN=

# ============ 运行模式 ============
# 留空 = 长轮询（本机/内网直接跑，最省事）
# 填写 = webhook 模式，例如 https://bot.example.com
WEBHOOK_BASE=
WEBHOOK_PATH=/tg/webhook
WEBHOOK_SECRET=
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080

# 访问 api.telegram.org 需要走代理时填（大陆服务器基本都要）
# 支持 http:// 和 socks5://，例如 socks5://127.0.0.1:1080
# 留空则直连；留空时也会自动沿用环境变量 HTTPS_PROXY
TELEGRAM_PROXY=

# ============ 存储 ============
DB_PATH=./data/bot.db

# ============ 汇率刷新节奏（秒）============
FIAT_REFRESH_SECONDS=60
CRYPTO_REFRESH_SECONDS=15
# 超过这个时长还没刷新成功，回复里会标注「数据较旧」
STALE_AFTER_SECONDS=900
HTTP_TIMEOUT=8

# ============ 提醒/播报 ============
ALERT_CHECK_SECONDS=60
MAX_ALERTS_PER_USER=30
MAX_SUBS_PER_USER=10

# ============ 新用户默认偏好 ============
DEFAULT_BASE=CNY
# 「只发一个金额」时列出的常用货币，用户可用 /fav 自行增删
DEFAULT_FAVORITES=USD,HKD,EUR,JPY,GBP,KRW,TWD,SGD,AUD,THB
# 一次列几行（常用列表不够长时用主流货币补齐）
MULTI_TARGET_COUNT=10
# 每个用户最多能收藏多少个常用货币
MAX_FAVORITES=20
DEFAULT_LANG=zh
DEFAULT_DECIMALS=2
DEFAULT_TZ=Asia/Shanghai

# ============ 其它 ============
# 逗号分隔，禁用某些数据源，例如：binance,coingecko
DISABLED_PROVIDERS=
# 每用户最小请求间隔（秒），防止长按刷新
RATE_LIMIT_SECONDS=0.4
LOG_LEVEL=INFO
